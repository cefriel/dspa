@prefix : <https://knowledge.c-innovationhub.com/dspa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://knowledge.c-innovationhub.com/dspa#> .

<https://knowledge.c-innovationhub.com/dspa> rdf:type owl:Ontology ;
                                              owl:versionIRI <https://knowledge.c-innovationhub.com/dspa/1.0.0> ;
                                              <http://purl.org/dc/terms/creator> "Alessio Carenini (Cefriel)"@en ,
                                                                                 "Mario Scrocca (Cefriel)"@en ;
                                              <http://purl.org/dc/terms/description> "A metadata schema to represent Data Product Offerings in dataspaces, aligned with Open Data Product Specifications, DCAT-AP and EDC metadata schema."@en ;
                                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                              <http://purl.org/dc/terms/publisher> "Cefriel"@en ;
                                              <http://purl.org/dc/terms/title> "DSPA Dataspace vocabulary"@en ;
                                              <http://purl.org/ontology/bibo/status> "Published Ontology"@en ;
                                              rdfs:comment "A metadata schema to represent Data Product Offerings in dataspaces, aligned with Open Data Product Specifications, DCAT-AP and EDC metadata schema." ;
                                              rdfs:label "DSPA  Dataspace vocabulary" ;
                                              owl:versionInfo "1.0.0"@en ;
                                              <https://schema.org/funding> <https://doi.org/CORDIS_DOI> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/status
<http://purl.org/ontology/bibo/status> rdf:type owl:AnnotationProperty .


###  https://knowledge.c-innovationhub.com/dspa#value
:value rdfs:comment "The actual value of the term." ;
       rdfs:label "value" ;
       rdf:type owl:AnnotationProperty ;
       rdfs:domain :DeclarativeTerm .


###  https://schema.org/funding
<https://schema.org/funding> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://knowledge.c-innovationhub.com/dspa#action
:action rdf:type owl:ObjectProperty ;
        rdfs:domain :ExecutablePricingPlan ;
        rdfs:range :PricingPlansAsCodeAction ;
        rdfs:comment "The action to be performed on the pricing plan." ;
        rdfs:label "action" .


###  https://knowledge.c-innovationhub.com/dspa#dataQualityDimension
:dataQualityDimension rdf:type owl:ObjectProperty ;
                      rdfs:domain :DataQualityTerm ;
                      rdfs:range :DataQualityDimension ;
                      rdfs:comment "Links a data quality term to its dimension." ;
                      rdfs:label "data quality dimension" .


###  https://knowledge.c-innovationhub.com/dspa#hasDataHolder
:hasDataHolder rdf:type owl:ObjectProperty ;
               rdfs:domain :DataProduct ;
               rdfs:range :DataHolder ;
               rdfs:comment "Links a data product to its data holder." ;
               rdfs:label "has data holder" .


###  https://knowledge.c-innovationhub.com/dspa#hasDataProductLicense
:hasDataProductLicense rdf:type owl:ObjectProperty ;
                       rdfs:domain :DataProduct ;
                       rdfs:range :DataProductLicense ;
                       rdfs:comment "Links a data product to its license information." ;
                       rdfs:label "has data product license" .


###  https://knowledge.c-innovationhub.com/dspa#hasDataQuality
:hasDataQuality rdf:type owl:ObjectProperty ;
                rdfs:domain :DataProduct ;
                rdfs:range :DataQuality ;
                rdfs:comment "Links a data product to its data quality specifications." ;
                rdfs:label "has data quality" .


###  https://knowledge.c-innovationhub.com/dspa#hasDataQualityTerm
:hasDataQualityTerm rdf:type owl:ObjectProperty ;
                    rdfs:domain :DataQuality ;
                    rdfs:range :DataQualityTerm ;
                    rdfs:comment "Links a data quality specification to its terms." ;
                    rdfs:label "has data quality term" .


###  https://knowledge.c-innovationhub.com/dspa#hasExecutableLicense
:hasExecutableLicense rdf:type owl:ObjectProperty ;
                      rdfs:domain :DataProductLicense ;
                      rdfs:range :ExecutableLicense ;
                      rdfs:comment "Links a data product license to its executable representation." ;
                      rdfs:label "has executable license" .


###  https://knowledge.c-innovationhub.com/dspa#hasLicenseGovernance
:hasLicenseGovernance rdf:type owl:ObjectProperty ;
                      rdfs:domain :DataProductLicense ;
                      rdfs:range :LicenseGovernance ;
                      rdfs:comment "Links a data product license to its governance rules and policies." ;
                      rdfs:label "has license governance" .


###  https://knowledge.c-innovationhub.com/dspa#hasLicenseScope
:hasLicenseScope rdf:type owl:ObjectProperty ;
                 rdfs:domain :DataProductLicense ;
                 rdfs:range :LicenseScope ;
                 rdfs:comment "Links a data product license to its scope and permitted uses." ;
                 rdfs:label "has license scope" .


###  https://knowledge.c-innovationhub.com/dspa#hasPolicy
:hasPolicy rdf:type owl:ObjectProperty ;
           rdfs:domain :ExecutableLicense ;
           rdfs:range <http://www.w3.org/ns/odrl/2/Policy> ;
           rdfs:comment "Links an executable license to its ODRL policy representation." ;
           rdfs:label "has policy" .


###  https://knowledge.c-innovationhub.com/dspa#hasPricingPlan
:hasPricingPlan rdf:type owl:ObjectProperty ;
                rdfs:domain :DataProduct ;
                rdfs:range :PricingPlan ;
                rdfs:comment "Links a data product to its pricing information." ;
                rdfs:label "has pricing plan" .


###  https://knowledge.c-innovationhub.com/dspa#hasProductSupport
:hasProductSupport rdf:type owl:ObjectProperty ;
                   rdfs:domain :ServiceLevelAgreement ;
                   rdfs:range :ProductSupport ;
                   rdfs:comment "Links a service level agreement to its support information." ;
                   rdfs:label "has product support" .


###  https://knowledge.c-innovationhub.com/dspa#hasServiceLevelAgreement
:hasServiceLevelAgreement rdf:type owl:ObjectProperty ;
                          rdfs:domain :DataProduct ;
                          rdfs:range :ServiceLevelAgreement ;
                          rdfs:comment "Links a data product to its service level agreement." ;
                          rdfs:label "has service level agreement" .


###  https://knowledge.c-innovationhub.com/dspa#hasServiceLevelAgreementTerms
:hasServiceLevelAgreementTerms rdf:type owl:ObjectProperty ;
                               rdfs:domain :ServiceLevelAgreement ;
                               rdfs:range :ServiceLevelAgreementTerm ;
                               rdfs:comment "Links a service level agreement to its terms, which can be either executable or declarative." ;
                               rdfs:label "has service level agreement terms" .


###  https://knowledge.c-innovationhub.com/dspa#hasTerminationCondition
:hasTerminationCondition rdf:type owl:ObjectProperty ;
                         rdfs:domain :DataProductLicense ;
                         rdfs:range :TerminationCondition ;
                         rdfs:comment "Links a data product license to its termination conditions." ;
                         rdfs:label "has termination condition" .


###  https://knowledge.c-innovationhub.com/dspa#providesResource
:providesResource rdf:type owl:ObjectProperty ;
                  rdfs:domain :DataProduct ;
                  rdfs:range <https://www.w3.org/ns/dcat#Resource> ;
                  rdfs:comment "Links a data product to its DCAT resource representation." ;
                  rdfs:label "provides resource" .


###  https://knowledge.c-innovationhub.com/dspa#serviceLevelAgreementDimension
:serviceLevelAgreementDimension rdf:type owl:ObjectProperty ;
                                rdfs:domain :ServiceLevelAgreementTerm ;
                                rdfs:range :ServiceLevelAgreementDimension ;
                                rdfs:comment "Links a service level agreement term to its dimension." ;
                                rdfs:label "service level agreement dimension" .


#################################################################
#    Data properties
#################################################################

###  https://knowledge.c-innovationhub.com/dspa#URL
:URL rdf:type owl:DatatypeProperty ;
     rdfs:domain :DataHolder ;
     rdfs:range xsd:anyURI ;
     rdfs:comment "The URL of the organization's website." ;
     rdfs:label "URL" .


###  https://knowledge.c-innovationhub.com/dspa#additionalPrice
:additionalPrice rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DeclarativePricingPlan ;
                 rdfs:range xsd:string ;
                 rdfs:comment "This is used to define fees for usage which exceeds the defined max transaction quantity. This value is for each additional transaction." ;
                 rdfs:label "additional price" .


###  https://knowledge.c-innovationhub.com/dspa#addressCountry
:addressCountry rdf:type owl:DatatypeProperty ;
                rdfs:domain :DataHolder ;
                rdfs:range xsd:string ;
                rdfs:comment "The country." ;
                rdfs:label "address country" .


###  https://knowledge.c-innovationhub.com/dspa#addressLocality
:addressLocality rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DataHolder ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The locality in which the street address is, and which is in the region. For example, Mountain View." ;
                 rdfs:label "address locality" .


###  https://knowledge.c-innovationhub.com/dspa#addressRegion
:addressRegion rdf:type owl:DatatypeProperty ;
               rdfs:domain :DataHolder ;
               rdfs:range xsd:string ;
               rdfs:comment "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level Administrative division" ;
               rdfs:label "address region" .


###  https://knowledge.c-innovationhub.com/dspa#aggregateRating
:aggregateRating rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DataHolder ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The average rating based on multiple ratings or reviews." ;
                 rdfs:label "aggregate rating" .


###  https://knowledge.c-innovationhub.com/dspa#applicableLaws
:applicableLaws rdf:type owl:DatatypeProperty ;
                rdfs:domain :LicenseGovernance ;
                rdfs:range xsd:string ;
                rdfs:comment "Applicable laws, i.e local acts, degrees or law." ;
                rdfs:label "applicable laws" .


###  https://knowledge.c-innovationhub.com/dspa#audit
:audit rdf:type owl:DatatypeProperty ;
       rdfs:domain :LicenseGovernance ;
       rdfs:range xsd:string ;
       rdfs:comment "License auditing terms." ;
       rdfs:label "audit" .


###  https://knowledge.c-innovationhub.com/dspa#billingDuration
:billingDuration rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DeclarativePricingPlan ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies for how long this price (or price component) will be billed. Can be used, for example, to model the contractual duration of a subscription or payment plan." ;
                 rdfs:label "billing duration" .


###  https://knowledge.c-innovationhub.com/dspa#businessDomain
:businessDomain rdf:type owl:DatatypeProperty ;
                rdfs:domain :DataHolder ;
                rdfs:range xsd:string ;
                rdfs:comment "In a data mesh architecture, data (or data product) ownership and management are distributed across self-contained business domains." ;
                rdfs:label "business domain" .


###  https://knowledge.c-innovationhub.com/dspa#businessID
:businessID rdf:type owl:DatatypeProperty ;
            rdfs:domain :DataHolder ;
            rdfs:range xsd:string ;
            rdfs:comment "The business identifier code of the company. Often this is given to the company by authorized public sector organization managing register of businesses." ;
            rdfs:label "business ID" .


###  https://knowledge.c-innovationhub.com/dspa#checkoutPublicKey
:checkoutPublicKey rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CheckoutBasedPricingPlan ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The public key used for Checkout.com integration." ;
                   rdfs:label "Checkout Public Key" .


###  https://knowledge.c-innovationhub.com/dspa#checkoutSecretKey
:checkoutSecretKey rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CheckoutBasedPricingPlan ;
                   rdfs:range xsd:string ;
                   rdfs:comment "The secret key used for Checkout.com integration." ;
                   rdfs:label "Checkout Secret Key" .


###  https://knowledge.c-innovationhub.com/dspa#confidentiality
:confidentiality rdf:type owl:DatatypeProperty ;
                 rdfs:domain :LicenseGovernance ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Restrictions and requirements imposed on the Data User regarding e.g. the use and disclosure of the Data Holder's confidential information." ;
                 rdfs:label "confidentiality" .


###  https://knowledge.c-innovationhub.com/dspa#contactName
:contactName rdf:type owl:DatatypeProperty ;
             rdfs:domain :DataHolder ;
             rdfs:range xsd:string ;
             rdfs:comment "Contact person name" ;
             rdfs:label "contact name" .


###  https://knowledge.c-innovationhub.com/dspa#continuityConditions
:continuityConditions rdf:type owl:DatatypeProperty ;
                      rdfs:domain :TerminationCondition ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Continuity conditions of the license." ;
                      rdfs:label "continuity conditions" .


###  https://knowledge.c-innovationhub.com/dspa#damages
:damages rdf:type owl:DatatypeProperty ;
         rdfs:domain :LicenseGovernance ;
         rdfs:range xsd:string ;
         rdfs:comment "Damages refers to the sum of money (i.e. indemnifications) for a breach of some duty or violation of license right." ;
         rdfs:label "damages" .


###  https://knowledge.c-innovationhub.com/dspa#definition
:definition rdf:type owl:DatatypeProperty ;
            rdfs:domain :LicenseScope ;
            rdfs:range xsd:string ;
            rdfs:comment "Background and purpose of the license." ;
            rdfs:label "definition" .


###  https://knowledge.c-innovationhub.com/dspa#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:domain :DataHolder ;
             rdfs:range xsd:string ;
             rdfs:comment "The introduction to the organization. Often contains information of what the organisation does and focuses on." ;
             rdfs:label "description" .


###  https://knowledge.c-innovationhub.com/dspa#documentationURL
:documentationURL rdf:type owl:DatatypeProperty ;
                  rdfs:domain :ProductSupport ;
                  rdfs:range xsd:anyURI ;
                  rdfs:comment "URL to documentation" ;
                  rdfs:label "documentation URL" .


###  https://knowledge.c-innovationhub.com/dspa#email
:email rdf:type owl:DatatypeProperty ;
       rdfs:domain :DataHolder ,
                   :ProductSupport ;
       rdfs:range xsd:string ;
       rdfs:comment "Email information for support requests. Use RFC2822" ,
                    "Email to be used in contacting the organization." ;
       rdfs:label "email" .


###  https://knowledge.c-innovationhub.com/dspa#emailServiceHours
:emailServiceHours rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ProductSupport ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Describes the email service hours company provides. Contains information often in week level eg Mon-Fri at 8am - 4pm." ;
                   rdfs:label "email service hours" .


###  https://knowledge.c-innovationhub.com/dspa#exclusive
:exclusive rdf:type owl:DatatypeProperty ;
           rdfs:domain :LicenseScope ;
           rdfs:range xsd:boolean ;
           rdfs:comment "The exclusive license holder is given complete control over the use of the data product, and no other person or organization is allowed to use it during the term of the license agreement." ;
           rdfs:label "exclusive" .


###  https://knowledge.c-innovationhub.com/dspa#forceMajeure
:forceMajeure rdf:type owl:DatatypeProperty ;
              rdfs:domain :LicenseGovernance ;
              rdfs:range xsd:string ;
              rdfs:comment "Force majeure is a clause that is included in contracts to remove liability for unforeseeable and unavoidable catastrophes that interrupt the expected course of events and prevent participants from fulfilling obligations. These clauses generally cover both natural disasters and catastrophes created by humans." ;
              rdfs:label "force majeure" .


###  https://knowledge.c-innovationhub.com/dspa#geographicalArea
:geographicalArea rdf:type owl:DatatypeProperty ;
                  rdfs:domain :LicenseScope ;
                  rdfs:range xsd:string ;
                  rdfs:comment "License right restricted to the geographical area." ;
                  rdfs:label "geographical area" .


###  https://knowledge.c-innovationhub.com/dspa#legalName
:legalName rdf:type owl:DatatypeProperty ;
           rdfs:domain :DataHolder ;
           rdfs:range xsd:string ;
           rdfs:comment "REQUIRED The official name of the organization, e.g. the registered company name." ;
           rdfs:label "legal name" .


###  https://knowledge.c-innovationhub.com/dspa#logoURL
:logoURL rdf:type owl:DatatypeProperty ;
         rdfs:domain :DataHolder ;
         rdfs:range xsd:anyURI ;
         rdfs:comment "The URL pointing to organisation logo." ;
         rdfs:label "logo URL" .


###  https://knowledge.c-innovationhub.com/dspa#maxDataQuantity
:maxDataQuantity rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DeclarativePricingPlan ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "The maximum amount of data transferred during the billing duration. Unit is GB." ;
                 rdfs:label "max data quantity" .


###  https://knowledge.c-innovationhub.com/dspa#maxPrice
:maxPrice rdf:type owl:DatatypeProperty ;
          rdfs:domain :DeclarativePricingPlan ;
          rdfs:range xsd:string ;
          rdfs:comment "The highest price if the price is a range. If dynamic pricing is used with this product, this is the highest price allowed." ;
          rdfs:label "max price" .


###  https://knowledge.c-innovationhub.com/dspa#maxTransactionQuantity
:maxTransactionQuantity rdf:type owl:DatatypeProperty ;
                        rdfs:domain :DeclarativePricingPlan ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "The maximum transaction quantity for the given billing duration. Use this to define for example monthly (or any other period) request limit to the data product. Note! If you want to set unlimited use, value must be 0 (zero)." ;
                        rdfs:label "max transaction quantity" .


###  https://knowledge.c-innovationhub.com/dspa#minPrice
:minPrice rdf:type owl:DatatypeProperty ;
          rdfs:domain :DeclarativePricingPlan ;
          rdfs:range xsd:string ;
          rdfs:comment "The lowest price if the price is a range. If dynamic pricing is used with this product, this is the lowest price allowed. In dynamic pricing businesses are able to change prices based on algorithms that take into account competitor pricing, supply and demand, and other external factors in the market." ;
          rdfs:label "min price" .


###  https://knowledge.c-innovationhub.com/dspa#monitoringSystemName
:monitoringSystemName rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ExecutableTerm ;
                      rdfs:range xsd:string ;
                      rdfs:comment "The name of the monitoring system used for this SLA term." ;
                      rdfs:label "monitoring system name" .


###  https://knowledge.c-innovationhub.com/dspa#monitoringSystemReference
:monitoringSystemReference rdf:type owl:DatatypeProperty ;
                           rdfs:domain :ExecutableTerm ;
                           rdfs:range xsd:anyURI ;
                           rdfs:comment "A reference URL to the monitoring system documentation." ;
                           rdfs:label "monitoring system reference" .


###  https://knowledge.c-innovationhub.com/dspa#monitoringSystemTermSpecification
:monitoringSystemTermSpecification rdf:type owl:DatatypeProperty ;
                                   rdfs:domain :ExecutableTerm ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "The specification of how this SLA term is monitored in the monitoring system." ;
                                   rdfs:label "monitoring system term specification" .


###  https://knowledge.c-innovationhub.com/dspa#noticePeriod
:noticePeriod rdf:type owl:DatatypeProperty ;
              rdfs:domain :TerminationCondition ;
              rdfs:range xsd:integer ;
              rdfs:comment "The notice period is a particular time that an data product provider or consumer must give before ending the contract. This time window allows both sides to make the necessary preparations, guaranteeing an unhindered transfer." ;
              rdfs:label "notice period" .


###  https://knowledge.c-innovationhub.com/dspa#objective
:objective rdf:type owl:DatatypeProperty ;
           rdfs:domain :DeclarativeTerm ;
           rdfs:range xsd:decimal ;
           rdfs:comment "The target value that should be achieved for the term." ;
           rdfs:label "objective" .


###  https://knowledge.c-innovationhub.com/dspa#offering
:offering rdf:type owl:DatatypeProperty ;
          rdfs:domain :DeclarativePricingPlan ;
          rdfs:range xsd:string ;
          rdfs:comment "The element that contains pricing plan content as array of strings. Think of this as the list of what is included in the pricing plan and what you offer in return to the price asked. Use the language defined in the plan" ;
          rdfs:label "offering" .


###  https://knowledge.c-innovationhub.com/dspa#ownership
:ownership rdf:type owl:DatatypeProperty ;
           rdfs:domain :LicenseGovernance ;
           rdfs:range xsd:string ;
           rdfs:comment "Data product licensing ownership." ;
           rdfs:label "ownership" .


###  https://knowledge.c-innovationhub.com/dspa#parentOrganization
:parentOrganization rdf:type owl:DatatypeProperty ;
                    rdfs:domain :DataHolder ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The larger organization that this organization is a subOrganization of, if any." ;
                    rdfs:label "parent organization" .


###  https://knowledge.c-innovationhub.com/dspa#paypalClientId
:paypalClientId rdf:type owl:DatatypeProperty ;
                rdfs:domain :PaypalBasedPricingPlan ;
                rdfs:range xsd:string ;
                rdfs:comment "The client ID used for PayPal integration." ;
                rdfs:label "PayPal Client ID" .


###  https://knowledge.c-innovationhub.com/dspa#paypalSecret
:paypalSecret rdf:type owl:DatatypeProperty ;
              rdfs:domain :PaypalBasedPricingPlan ;
              rdfs:range xsd:string ;
              rdfs:comment "The secret key used for PayPal integration." ;
              rdfs:label "PayPal Secret" .


###  https://knowledge.c-innovationhub.com/dspa#permanent
:permanent rdf:type owl:DatatypeProperty ;
           rdfs:domain :LicenseScope ;
           rdfs:range xsd:boolean ;
           rdfs:comment "License with no expiration date." ;
           rdfs:label "permanent" .


###  https://knowledge.c-innovationhub.com/dspa#phoneNumber
:phoneNumber rdf:type owl:DatatypeProperty ;
             rdfs:domain :ProductSupport ;
             rdfs:range xsd:string ;
             rdfs:comment "The support phone number. Use E.164" ;
             rdfs:label "phone number" .


###  https://knowledge.c-innovationhub.com/dspa#phoneServiceHours
:phoneServiceHours rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ProductSupport ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Describes the service hours company provides. Contains information often in week level eg Mon-Fri at 8am - 4pm." ;
                   rdfs:label "phone service hours" .


###  https://knowledge.c-innovationhub.com/dspa#postalCode
:postalCode rdf:type owl:DatatypeProperty ;
            rdfs:domain :DataHolder ;
            rdfs:range xsd:string ;
            rdfs:comment "The postal code. For example, 94043." ;
            rdfs:label "postal code" .


###  https://knowledge.c-innovationhub.com/dspa#price
:price rdf:type owl:DatatypeProperty ;
       rdfs:domain :DeclarativePricingPlan ;
       rdfs:range xsd:string ;
       rdfs:comment "The offer price of a product, or of a price component, or revenue-sharing percentage. If the unit of pricing is revenue-sharing, then this price attribute value is percentage value. Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator. Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols. With data-volume the price is for each 1GB of data." ;
       rdfs:label "price" .


###  https://knowledge.c-innovationhub.com/dspa#priceCurrency
:priceCurrency rdf:type owl:DatatypeProperty ;
               rdfs:domain :DeclarativePricingPlan ;
               rdfs:range xsd:string ;
               rdfs:comment "The primary currency used in pricing. Platforms are assumed to use this as primary currency if currency conversions are used to display product pricing in different locations for various currencies. If the unit is revenue-sharing, then this attribute value MUST be percentage." ;
               rdfs:label "price currency" .


###  https://knowledge.c-innovationhub.com/dspa#ratingCount
:ratingCount rdf:type owl:DatatypeProperty ;
             rdfs:domain :DataHolder ;
             rdfs:range xsd:integer ;
             rdfs:comment "The amount of ratings and reviews used in calculating the aggregateRating." ;
             rdfs:label "rating count" .


###  https://knowledge.c-innovationhub.com/dspa#reference
:reference rdf:type owl:DatatypeProperty ;
           rdfs:domain :ExecutablePricingPlan ;
           rdfs:range xsd:anyURI ;
           rdfs:comment "Provide URL pointing to the reference documentation" ;
           rdfs:label "reference" .


###  https://knowledge.c-innovationhub.com/dspa#restrictions
:restrictions rdf:type owl:DatatypeProperty ;
              rdfs:domain :LicenseScope ;
              rdfs:range xsd:string ;
              rdfs:comment "Restrictions of the license." ;
              rdfs:label "restrictions" .


###  https://knowledge.c-innovationhub.com/dspa#rights
:rights rdf:type owl:DatatypeProperty ;
        rdfs:domain :LicenseScope ;
        rdfs:range xsd:string ;
        rdfs:comment "Rights granted by the licence. The texts in brackets and italic are intended to describe rights." ;
        rdfs:label "rights" .


###  https://knowledge.c-innovationhub.com/dspa#slogan
