        <rdfs:label>monitoring system term specification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#noticePeriod -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#noticePeriod">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#TerminationCondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The notice period is a particular time that an data product provider or consumer must give before ending the contract. This time window allows both sides to make the necessary preparations, guaranteeing an unhindered transfer.</rdfs:comment>
        <rdfs:label>notice period</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#objective -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#objective">
