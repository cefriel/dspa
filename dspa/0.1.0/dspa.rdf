        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The element that contains pricing plan content as array of strings. Think of this as the list of what is included in the pricing plan and what you offer in return to the price asked. Use the language defined in the plan</rdfs:comment>
        <rdfs:label>offering</rdfs:label>
    </owl:DatatypeProperty>
    


