        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The region in which the locality is, and which is in the country. For example, California or another appropriate first-level Administrative division</rdfs:comment>
        <rdfs:label>address region</rdfs:label>
    </owl:DatatypeProperty>
    


