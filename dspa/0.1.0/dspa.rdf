    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#additionalPrice">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DeclarativePricingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
