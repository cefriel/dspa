        <rdfs:label>monitoring system name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#monitoringSystemReference -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#monitoringSystemReference">
