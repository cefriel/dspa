    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#emailServiceHours">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#ProductSupport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes the email service hours company provides. Contains information often in week level eg Mon-Fri at 8am - 4pm.</rdfs:comment>
        <rdfs:label>email service hours</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#exclusive -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#exclusive">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#LicenseScope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>The exclusive license holder is given complete control over the use of the data product, and no other person or organization is allowed to use it during the term of the license agreement.</rdfs:comment>
        <rdfs:label>exclusive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#forceMajeure -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#forceMajeure">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#LicenseGovernance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Force majeure is a clause that is included in contracts to remove liability for unforeseeable and unavoidable catastrophes that interrupt the expected course of events and prevent participants from fulfilling obligations. These clauses generally cover both natural disasters and catastrophes created by humans.</rdfs:comment>
        <rdfs:label>force majeure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#geographicalArea -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#geographicalArea">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#LicenseScope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>License right restricted to the geographical area.</rdfs:comment>
        <rdfs:label>geographical area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#legalName -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#legalName">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DataHolder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>REQUIRED The official name of the organization, e.g. the registered company name.</rdfs:comment>
        <rdfs:label>legal name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#logoURL -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#logoURL">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DataHolder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>The URL pointing to organisation logo.</rdfs:comment>
        <rdfs:label>logo URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#maxDataQuantity -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#maxDataQuantity">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DeclarativePricingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The maximum amount of data transferred during the billing duration. Unit is GB.</rdfs:comment>
        <rdfs:label>max data quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#maxPrice -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#maxPrice">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DeclarativePricingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The highest price if the price is a range. If dynamic pricing is used with this product, this is the highest price allowed.</rdfs:comment>
        <rdfs:label>max price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#maxTransactionQuantity -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#maxTransactionQuantity">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DeclarativePricingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The maximum transaction quantity for the given billing duration. Use this to define for example monthly (or any other period) request limit to the data product. Note! If you want to set unlimited use, value must be 0 (zero).</rdfs:comment>
        <rdfs:label>max transaction quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#minPrice -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#minPrice">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DeclarativePricingPlan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The lowest price if the price is a range. If dynamic pricing is used with this product, this is the lowest price allowed. In dynamic pricing businesses are able to change prices based on algorithms that take into account competitor pricing, supply and demand, and other external factors in the market.</rdfs:comment>
        <rdfs:label>min price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#monitoringSystemName -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#monitoringSystemName">
