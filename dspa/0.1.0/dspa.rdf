        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The country.</rdfs:comment>
        <rdfs:label>address country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#addressLocality -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#addressLocality">
        <rdfs:domain rdf:resource="https://knowledge.c-innovationhub.com/dspa#DataHolder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The locality in which the street address is, and which is in the region. For example, Mountain View.</rdfs:comment>
        <rdfs:label>address locality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://knowledge.c-innovationhub.com/dspa#addressRegion -->


    <owl:DatatypeProperty rdf:about="https://knowledge.c-innovationhub.com/dspa#addressRegion">
